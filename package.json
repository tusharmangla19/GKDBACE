{
  "name": "iyf-sadhana",
  "private": true,
  "version": "1.0.0",
  "description": "Sadhana tracker for the IYF devotee group: an Expo mobile app on a shared, framework-free core.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run web --workspace @iyf/mobile --",
    "web:build": "npm run web:build --workspace @iyf/mobile",
    "mobile": "npm run start --workspace @iyf/mobile",
    "mobile:android": "npm run android --workspace @iyf/mobile",
    "mobile:ios": "npm run ios --workspace @iyf/mobile",
    "apk": "bash scripts/build-apk.sh",
    "apk:clean": "CLEAN=1 bash scripts/build-apk.sh",
    "rules": "node scripts/generate-firestore-rules.mjs",
    "migrate": "node scripts/migrate-to-day-keys.mjs",
    "clear-db": "node scripts/clear-firestore.mjs",
    "check": "npm run check:mobile",
    "check:mobile": "npm run check --workspace @iyf/mobile"
  }
}
